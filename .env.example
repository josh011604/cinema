# Copy this file to ".env" and fill in the values from your Supabase project.
# Both are found in the Supabase dashboard under Project Settings -> API Keys
# (and the "Connect" button at the top of the project).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
